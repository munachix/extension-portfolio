# Copy to .env (never commit .env). Only needed for: pnpm scorecard import-revenue
# Lemon Squeezy: Settings → API → new key. Store id: Settings → Stores.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Polar (if you use it instead): Settings → Developers → new token with orders:read.
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
